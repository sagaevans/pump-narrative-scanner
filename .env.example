# Pump Narrative Scanner - Environment Configuration

# App settings
APP_HOST=127.0.0.1
APP_PORT=8000

# Database path (relative to project root)
DATABASE_PATH=data/coins.db

# Research settings
SCAN_INTERVAL_SECONDS=60

# Data source settings (all public, read-only, no auth required)
# DexScreener (primary - most reliable)
DEXSCREENER_BOOSTS_URL=https://api.dexscreener.com/token-boosts/latest/v1
DEXSCREENER_PROFILES_URL=https://api.dexscreener.com/token-profiles/latest/v1
DEXSCREENER_TOKENS_URL=https://api.dexscreener.com/tokens/v1/solana

# pump.fun API v3 (secondary - may be blocked by Cloudflare in some environments)
PUMP_API_URL=https://frontend-api-v3.pump.fun/coins/latest

# Fetch settings
PUMP_API_TIMEOUT=20
PUMP_FETCH_LIMIT=20
