# Pump Narrative Scanner - Environment Configuration

# App settings
APP_HOST=127.0.0.1
APP_PORT=8000

# Database path (relative to project root)
DATABASE_PATH=data/coins.db

# Research settings
SCAN_INTERVAL_SECONDS=60

# Pump.fun public API settings (read-only, no auth required)
PUMP_API_URL=https://frontend-api-v2.pump.fun/coins/latest
PUMP_API_TIMEOUT=15
PUMP_FETCH_LIMIT=20
